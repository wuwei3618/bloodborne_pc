From 82bd1184aa7136574f677febbbe6ed62a609c4f4 Mon Sep 17 00:00:00 2001
From: wuwei3618 <wuwei3618@live.com>
Date: Wed, 7 Oct 2026 08:10:06 +0800
Subject: [PATCH] FSR 3.1.4 Vulkan backend: device-local memory on
 unified-memory devices

bbport: findMemoryTypeIndex skips host-visible types for device-local
requests, to keep resources out of a discrete GPU's small host-visible
heap. KosmicKrisp on Apple silicon has a single memory type, device-local
and host-visible, so no type was found for any image: the context
creation failed with FFX_ERROR_BACKEND_API_ERROR. Without a device-local
type that is not host-visible, use the first host-visible one.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp b/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
index b2439b6..afda85b 100644
--- a/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
@@ -425,6 +425,9 @@ uint32_t findMemoryTypeIndex(
     vkGetPhysicalDeviceMemoryProperties(physicalDevice, &memProperties);
 
     uint32_t bestCandidate = UINT32_MAX;
+    // bbport: a unified-memory device (KosmicKrisp on Apple silicon) has no device-local type
+    // that is not host-visible; device-local requests then use a host-visible one.
+    uint32_t hostVisibleDeviceLocal = UINT32_MAX;
 
     for (uint32_t i = 0; i < memProperties.memoryTypeCount; i++) {
         const VkMemoryPropertyFlags memoryProperties = memProperties.memoryTypes[i].propertyFlags;
@@ -440,8 +443,11 @@ uint32_t findMemoryTypeIndex(
             (memoryProperties & requestedProperties) == requestedProperties) {
 
             // if just device-local memory is requested, make sure this is the invisible heap to prevent over-subscribing the local heap
-            if (requestedProperties == VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT && (memoryProperties & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+            if (requestedProperties == VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT && (memoryProperties & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) {
+                if (hostVisibleDeviceLocal == UINT32_MAX)
+                    hostVisibleDeviceLocal = i;
                 continue;
+            }
 
             bestCandidate = i;
             outProperties = memoryProperties;
@@ -452,6 +458,11 @@ uint32_t findMemoryTypeIndex(
         }
     }
 
+    if (bestCandidate == UINT32_MAX && hostVisibleDeviceLocal != UINT32_MAX) {
+        bestCandidate = hostVisibleDeviceLocal;
+        outProperties = memProperties.memoryTypes[hostVisibleDeviceLocal].propertyFlags;
+    }
+
     return bestCandidate;
 }
 
